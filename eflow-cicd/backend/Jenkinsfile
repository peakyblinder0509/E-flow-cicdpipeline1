pipeline {
    agent any

    environment {
        // ── Project ──────────────────────────────
        SERVICE_NAME   = 'userservice'       // ← change per microservice
        REPO_URL       = 'https://github.com/peakyblinder0509/eflow-userservice'

        // ── SonarQube ────────────────────────────
        SONAR_PROJECT_KEY = "eflow-${SERVICE_NAME}"

        // ── Harbor Registry ──────────────────────
        HARBOR_REGISTRY  = 'harbor-node1.com'
        HARBOR_PROJECT   = 'eflow'
        IMAGE_NAME       = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}"
        IMAGE_TAG        = "${BUILD_NUMBER}"

        // ── AWS EKS ──────────────────────────────
        EKS_CLUSTER_NAME = 'eflow-cluster'
        AWS_REGION       = 'eu-north-1'
        K8S_NAMESPACE    = 'eflow'

        // ── Monitoring ───────────────────────────
        PROMETHEUS_URL   = 'http://<PROMETHEUS_IP>:9090'
        GRAFANA_URL      = 'http://<GRAFANA_IP>:3000'
    }

    tools {
        nodejs 'NodeJS-18'
    }

    stages {

        // ─────────────────────────────────────────
        // STAGE 1 : GitHub Checkout
        // ─────────────────────────────────────────
        stage('1 - GitHub Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: "${REPO_URL}"
            }
        }

        // ─────────────────────────────────────────
        // STAGE 2 : Install Dependencies
        // ─────────────────────────────────────────
        stage('2 - Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        // ─────────────────────────────────────────
        // STAGE 3 : SonarQube Scan
        // ─────────────────────────────────────────
        stage('3 - SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        npx sonar-scanner \
                          -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                          -Dsonar.sources=. \
                          -Dsonar.exclusions=node_modules/**,coverage/** \
                          -Dsonar.host.url=${SONAR_HOST_URL} \
                          -Dsonar.login=${SONAR_AUTH_TOKEN}
                    """
                }
            }
        }

        // ─────────────────────────────────────────
        // STAGE 4 : SonarQube Quality Gate
        // ─────────────────────────────────────────
        stage('4 - SonarQube Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────
        // STAGE 5 : Docker Image Build
        // ─────────────────────────────────────────
        stage('5 - Docker Image Build') {
            steps {
                sh """
                    docker build \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${IMAGE_NAME}:latest \
                      .
                """
            }
        }

        // ─────────────────────────────────────────
        // STAGE 6 : Harbor Login
        // ─────────────────────────────────────────
        stage('6 - Harbor Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-creds',
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASS'
                )]) {
                    sh """
                        echo "${HARBOR_PASS}" | docker login ${HARBOR_REGISTRY} \
                          -u "${HARBOR_USER}" --password-stdin
                    """
                }
            }
        }

        // ─────────────────────────────────────────
        // STAGE 7 : Tag Docker Image
        // ─────────────────────────────────────────
        stage('7 - Tag Docker Image') {
            steps {
                sh """
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:${IMAGE_TAG}
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                """
                // Build number tag  → rollback ku use aagum
                // latest tag        → always latest version point aagum
            }
        }

        // ─────────────────────────────────────────
        // STAGE 8 : Push Image to Harbor
        // ─────────────────────────────────────────
        stage('8 - Push Image to Harbor') {
            steps {
                sh """
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                """
            }
        }

        // ─────────────────────────────────────────
        // STAGE 9 : Deploy to AWS EKS
        // ─────────────────────────────────────────
        stage('9 - Deploy to EKS') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-creds']]) {
                    sh """
                        # kubeconfig update
                        aws eks update-kubeconfig \
                          --name ${EKS_CLUSTER_NAME} \
                          --region ${AWS_REGION}

                        # Rolling update - zero downtime
                        kubectl set image deployment/${SERVICE_NAME} \
                          ${SERVICE_NAME}=${IMAGE_NAME}:${IMAGE_TAG} \
                          -n ${K8S_NAMESPACE}

                        # Rollout complete aaguthu nu wait pannudhu
                        kubectl rollout status deployment/${SERVICE_NAME} \
                          -n ${K8S_NAMESPACE} \
                          --timeout=120s
                    """
                }
            }
        }

        // ─────────────────────────────────────────
        // STAGE 10 : Check Service External IP
        // ─────────────────────────────────────────
        stage('10 - Check Service External IP') {
            steps {
                sh """
                    echo "=== All Services in namespace: ${K8S_NAMESPACE} ==="
                    kubectl get svc -n ${K8S_NAMESPACE}

                    echo "=== ${SERVICE_NAME} External IP ==="
                    kubectl get svc ${SERVICE_NAME} \
                      -n ${K8S_NAMESPACE} \
                      -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'
                """
            }
        }

        // ─────────────────────────────────────────
        // STAGE 11 : Prometheus Monitoring Check
        // ─────────────────────────────────────────
        stage('11 - Prometheus Monitoring Check') {
            steps {
                sh """
                    echo "=== Prometheus Targets Check ==="
                    STATUS=\$(curl -s ${PROMETHEUS_URL}/api/v1/targets \
                      | grep -o '"health":"[^"]*"' | head -5)
                    echo "Target Health: \$STATUS"

                    curl -s "${PROMETHEUS_URL}/api/v1/query?query=up{job='${SERVICE_NAME}'}" \
                      | python3 -m json.tool || echo "Metric not yet available"
                """
            }
        }

        // ─────────────────────────────────────────
        // STAGE 12 : Grafana Dashboard Verification
        // ─────────────────────────────────────────
        stage('12 - Grafana Dashboard Verification') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'grafana-creds',
                    usernameVariable: 'GRAFANA_USER',
                    passwordVariable: 'GRAFANA_PASS'
                )]) {
                    sh """
                        echo "=== Grafana Health Check ==="
                        curl -s -u "${GRAFANA_USER}:${GRAFANA_PASS}" \
                          ${GRAFANA_URL}/api/health \
                          | python3 -m json.tool

                        echo "=== Grafana Dashboards List ==="
                        curl -s -u "${GRAFANA_USER}:${GRAFANA_PASS}" \
                          ${GRAFANA_URL}/api/search \
                          | python3 -m json.tool
                    """
                }
            }
        }
    }

    // ─────────────────────────────────────────
    // POST ACTIONS
    // ─────────────────────────────────────────
    post {
        success {
            echo "✅ ${SERVICE_NAME} — Build #${BUILD_NUMBER} deployed successfully!"
        }
        failure {
            echo "❌ ${SERVICE_NAME} pipeline failed at Build #${BUILD_NUMBER}!"
            sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
        always {
            sh "docker image prune -f || true"
        }
    }
}
